<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="org.autojs.permission.PLUGIN" />

    <!-- The launch pages follow AutoJs6's language, night mode and theme colors (host settings contract). -->
    <queries>
        <package android:name="org.autojs.autojs6" />
    </queries>

    <!--
        A resource-only plugin (ROADMAP.md D3): AutoJs6 loads the exported Java packages straight from this APK with a
        class loader of its own, so no script call ever starts this process, and the plugin asks for no permission.
    -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:icon="@mipmap/ic_icon_studio_application"
        android:roundIcon="@mipmap/ic_icon_studio_application">

        <meta-data
            android:name="org.autojs.plugin.contract.NATIVE_PAGE_ALIGNMENT"
            android:value="0" />

        <meta-data android:name="org.autojs.plugin.WAKE_ACTIVITY" android:value=".WakeActivity" />
        <meta-data android:name="org.autojs.plugin.info.AUTHOR" android:value="SuperMonster003" />
        <meta-data android:name="requiresHostVersion" android:value="${requiredHostVersion}" />

        <!--
            ROADMAP.md D9: the Java packages AutoJs6 scripts load from this APK, comma separated (host
            PluginJavaPackageCatalog). Keep in step with JavaLibrariesContract.EXPORTED_PACKAGES and proguard-rules.pro
            (JavaLibrariesCatalogTest and .python/check_repository.py check all three).
        -->
        <meta-data
            android:name="org.autojs.plugin.javaPackages.EXPORTS"
            android:value="org.apache.commons.lang3,org.apache.commons.io,com.fasterxml.jackson" />

        <!-- The launch page of the Plugin Center entry (ROADMAP.md D12): the libraries, their use and NOTICE files. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.JavaLibraries">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ReleaseHistoryActivity"
            android:exported="false"
            android:label="@string/text_release_history"
            android:theme="@style/Theme.JavaLibraries" />

        <activity
            android:name=".WakeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.autojs.plugin.action.WAKE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".JavaLibrariesInfoService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <meta-data android:name="requiresHostVersion" android:value="${requiredHostVersion}" />
            <intent-filter>
                <action android:name="org.autojs.plugin.INFO" />
                <category android:name="java-libraries" />
            </intent-filter>
        </service>

    </application>

</manifest>
